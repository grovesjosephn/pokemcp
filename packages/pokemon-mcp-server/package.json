{
  "name": "pokemon-mcp-server",
  "version": "1.0.0",
  "description": "Pokemon MCP Server - Comprehensive Pokemon data through Model Context Protocol",
  "keywords": [
    "ai-tools",
    "mcp",
    "model-context-protocol",
    "pokemon",
    "server"
  ],
  "bin": {
    "pokemon-mcp-server": "./dist/server.js"
  },
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "build": "bun run build:ui && tsc",
    "build:ui": "vite build",
    "dev": "bun --watch server.ts",
    "start": "bun server.ts",
    "inspect": "bunx @modelcontextprotocol/inspector bun server.ts",
    "inspect:cli": "bunx @modelcontextprotocol/inspector --cli bun server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:run": "bun test",
    "clean": "rm -rf dist",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepublishOnly": "bun run build",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.1",
    "@types/node": "^20.11.30",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "bun-types": "latest",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.4.2",
    "vite": "^8.0.3",
    "vite-plugin-singlefile": "^2.3.2"
  },
  "mcp": {
    "server": {
      "command": "bun",
      "args": [
        "server.ts"
      ],
      "env": {}
    }
  }
}
