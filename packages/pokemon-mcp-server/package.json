{
  "name": "pokemon-mcp-server",
  "version": "1.0.0",
  "description": "Pokemon MCP Server - Comprehensive Pokemon data through Model Context Protocol",
  "main": "server.ts",
  "type": "module",
  "bin": {
    "pokemon-mcp-server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun --watch server.ts",
    "start": "bun server.ts",
    "inspect": "bunx @modelcontextprotocol/inspector bun server.ts",
    "inspect:cli": "bunx @modelcontextprotocol/inspector --cli bun server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:run": "bun test",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "bun run build",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.1",
    "@types/node": "^20.11.30",
    "bun-types": "latest",
    "typescript": "^5.4.2"
  },
  "keywords": [
    "mcp",
    "pokemon",
    "server",
    "model-context-protocol",
    "ai-tools"
  ],
  "mcp": {
    "server": {
      "command": "bun",
      "args": [
        "server.ts"
      ],
      "env": {}
    }
  }
}
