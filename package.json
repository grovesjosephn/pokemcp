{
  "name": "pokemcp",
  "version": "1.0.0",
  "private": true,
  "description": "Pokemon MCP Monorepo",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "test": "bun run --filter '*' test:run",
    "test:watch": "bun run --filter '*' test",
    "test:run": "bun run --filter '*' test:run",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "oxfmt": "latest",
    "oxlint": "latest"
  }
}
